# MongoDB
MONGO_DATABASE=temperature
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=
MONGO_APP_USERNAME=temperature_app
MONGO_APP_PASSWORD=

# Cassandra
CASSANDRA_KEYSPACE=temperature
CASSANDRA_DATACENTER=datacenter1
CASSANDRA_APP_USERNAME=temperature_app
CASSANDRA_APP_PASSWORD=

# Redis
REDIS_PASSWORD=

# Kafka
KAFKA_TOPIC_MEASUREMENTS=mesures-temperature
KAFKA_TOPIC_DLQ=mesures-temperature-dlq
KAFKA_CONSUMER_GROUP=traitement-temperature

# Backend
SERVER_PORT=8080

# Pagination signée (au moins 32 caractères ; init-env.py le génère)
CURSOR_SECRET=
